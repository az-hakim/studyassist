{
  "name": "studyassistant-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @studyassistant/web dev",
    "build": "pnpm --filter @studyassistant/web build",
    "preview": "pnpm --filter @studyassistant/web preview",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop:dev": "pnpm --filter @studyassistant/desktop dev",
    "desktop:dist": "pnpm --filter @studyassistant/desktop dist",
    "android:add": "pnpm build && pnpm --filter @studyassistant/android add:platform",
    "android:sync": "pnpm build && pnpm --filter @studyassistant/android sync",
    "android:debug": "pnpm android:sync && pnpm --filter @studyassistant/android debug"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
